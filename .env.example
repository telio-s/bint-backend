APP_NAME=bint-backend
APP_ENV=development
LOG_LEVEL=info
PORT=8080
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=bint
DATABASE_HOST=localhost
DATABASE_PORT=5432
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/bint?sslmode=disable

# Use a random value of at least 32 characters. Never commit the production secret.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=bint-backend
JWT_AUDIENCE=bint-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/complete
AUTH_FAILURE_REDIRECT_URL=http://localhost:3000/auth/error

# Set true behind HTTPS in production. Leave COOKIE_DOMAIN empty for host-only cookies.
COOKIE_SECURE=false
COOKIE_DOMAIN=
OAUTH_TEMPORARY_COOKIE_TTL=10m
